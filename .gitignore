# =============================================================================
# MovieGenerator .gitignore
# =============================================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary processing files
*.log
*_temp*
*_last_frame_temp.png
ffmpeg_list.txt

# Projects directory rules:
# 1. Ignore all generated project asset subdirectories (Characters, Scenes, Movie)
Projects/*/
!Projects/three_scenes_example/
!Projects/three_scenes_example/*/

# 2. Ignore all user screenplay JSONs except the official example
Projects/*.json
!Projects/three_scenes_example.json


# IDE & editor configurations
.idea/
.vscode/
*.swp
*.swo
*~

# Local user machine configuration (generated interactively, not overwritten by git pull)
settings.json

# Machine-specific model & LoRA catalog (built locally during setup or first run)
Presets/t2i_presets.json
!Presets/t2i_presets.example.json

Projects/*.json.bak
